# LPU Campus Atlas needs NO secrets to build or run. All variables are optional
# and public (anything prefixed VITE_ is embedded in the browser bundle — never
# put a secret in a VITE_ variable).

# Public URL of the deployed site, used for canonical/OG metadata.
VITE_PUBLIC_SITE_URL=

# Optional public URL where users can file data corrections (e.g. a GitHub
# "new issue" URL). When empty, the correction form produces a local draft only.
VITE_CORRECTIONS_URL=

# Contact string sent in the User-Agent of data-fetch scripts (Overpass/OSM
# usage policy asks for an identifiable client). Used only by scripts/, never
# shipped to the browser.
DATA_FETCH_CONTACT=

# Optional satellite imagery (free sources only; docs/MAP_PROVIDER_CONFIGURATION.md §Modes).
# ArcGIS Location Platform API key for Esri World Imagery (free tier, no payment
# method; restrict it to this site's referrers and the Basemaps privilege). It is
# PUBLIC once built (VITE_), so put the real value only in .env.local or the
# host's build settings — never commit it. Empty = no Esri imagery.
VITE_ARCGIS_API_KEY=

# "true" adds the keyless EOX Sentinel-2 cloudless 2016 backdrop (10 m, low zoom
# only; used for Satellite 2D when no Esri key is set). Empty = off.
VITE_EOX_BACKDROP=
