{
  "name": "lpu-campus-atlas",
  "version": "0.1.0",
  "description": "LPU Campus Atlas — 3D campus map, search and walking navigation for Lovely Professional University, built from verifiable open data.",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:check && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "data:fetch": "node scripts/fetch-osm.ts",
    "data:fetch-public": "node scripts/fetch-public-data.ts",
    "data:build": "node scripts/build-data.ts",
    "data:validate": "node scripts/validate-data.ts",
    "data:check": "npm run data:build && npm run data:validate",
    "smoke": "node scripts/smoke.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run data:check && vite build && npm run smoke && npm run test:e2e"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "maplibre-gl": "6.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
