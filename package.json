{
  "name": "lpu-campus-atlas",
  "version": "0.1.0",
  "description": "LPU Campus Atlas — 3D campus map, search and walking navigation for Lovely Professional University, built from verifiable open data.",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:check && npm run art:check && tsc --noEmit && vite build && npm run art:check-dist",
    "preview": "vite preview --port 4173 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:modules": "node scripts/ci/check-modules.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/unit/search/performance.test.ts --exclude tests/unit/building-studio/perf.test.ts --exclude tests/unit/routing/robustness.test.ts --exclude tests/unit/routing/astar.test.ts --exclude tests/unit/community/merge-real.test.ts --exclude tests/unit/isometric/scene-real.test.ts",
    "test:perf": "vitest run --no-file-parallelism tests/unit/search/performance.test.ts tests/unit/building-studio/perf.test.ts tests/unit/routing/robustness.test.ts tests/unit/routing/astar.test.ts tests/unit/community/merge-real.test.ts tests/unit/isometric/scene-real.test.ts",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:browsers": "node scripts/ci/require-browsers.ts",
    "test:a11y": "playwright test tests/e2e --grep @a11y",
    "data:fetch": "node scripts/fetch-osm.ts",
    "data:fetch-public": "node scripts/fetch-public-data.ts",
    "data:fetch-footprints": "node scripts/fetch-footprints.ts",
    "data:keys": "node scripts/assign-directory-keys.ts",
    "data:build": "node scripts/build-data.ts",
    "data:validate": "node scripts/validate-data.ts",
    "data:check": "npm run data:build && npm run data:validate",
    "art:build": "node scripts/build-isometric-art.ts",
    "art:check": "node scripts/build-isometric-art.ts --check",
    "art:derive": "node scripts/build-isometric-art.ts --derive",
    "art:verify": "node scripts/build-isometric-art.ts --verify",
    "art:check-dist": "node scripts/build-isometric-art.ts --check-dist dist",
    "smoke": "node scripts/smoke.ts",
    "perf:bundle": "node scripts/perf/bundle.ts",
    "perf:search": "node scripts/perf/search.ts",
    "perf:route": "node scripts/perf/route.ts",
    "perf:load": "node scripts/perf/load.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:server && npm run test:browsers && npm run test && npm run test:perf && npm run test:server && npm run data:check && npm run art:check && vite build && npm run art:check-dist && npm run smoke && npm run perf:bundle && npm run test:e2e",
    "admin:hash-password": "node scripts/admin-hash-password.ts",
    "test:server": "vitest run -c vitest.server.config.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "db:migrate:local": "wrangler d1 migrations apply lpu-atlas --local"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "maplibre-gl": "6.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
