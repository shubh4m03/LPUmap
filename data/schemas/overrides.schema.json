{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^(osm:(node|way|relation)\\/\\d+|cur:[a-z0-9][a-z0-9-]*)$"
          },
          "set": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "categoryId": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "openingHours": {
                "type": "string",
                "minLength": 1
              },
              "wheelchair": {
                "type": "string",
                "enum": ["yes", "limited", "no", "unknown"]
              }
            },
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              },
              "licenseUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name"],
            "additionalProperties": false
          },
          "check": {
            "type": "string",
            "enum": ["physical-survey", "official-publication", "unverified-report"]
          },
          "lastVerifiedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z)?$"
          },
          "verifiedBy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["target", "set", "source", "check", "lastVerifiedAt"],
        "additionalProperties": false
      }
    }
  },
  "required": ["overrides"],
  "additionalProperties": false
}
