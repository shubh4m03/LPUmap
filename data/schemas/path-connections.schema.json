{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^(osm:(node|way|relation)\\/\\d+|cur:[a-z0-9][a-z0-9-]*)$"
          },
          "to": {
            "type": "string",
            "pattern": "^(osm:(node|way|relation)\\/\\d+|cur:[a-z0-9][a-z0-9-]*)$"
          },
          "pathOsmWayId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "evidence": {
            "type": "string",
            "enum": ["osm-tagging", "physical-survey", "official-publication"]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "retrievedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z)?$"
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              },
              "licenseUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name", "url", "retrievedAt"],
            "additionalProperties": false
          }
        },
        "required": ["from", "to", "pathOsmWayId", "evidence", "note", "source"],
        "additionalProperties": false
      }
    }
  },
  "required": ["connections"],
  "additionalProperties": false
}
