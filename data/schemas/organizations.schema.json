{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cur:[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "categoryId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "const": "organization"
          },
          "description": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "anchor": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^(osm:(node|way|relation)\\/\\d+|cur:[a-z0-9][a-z0-9-]*)$"
              }
            },
            "required": ["target"]
          },
          "source": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "retrievedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z)?$"
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              },
              "licenseUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["name", "url", "retrievedAt"],
            "additionalProperties": {}
          },
          "verificationStatus": {
            "type": "string",
            "enum": ["verified", "imported", "estimated", "unverified"]
          }
        },
        "required": ["id", "name", "aliases", "categoryId", "kind", "source", "verificationStatus"],
        "additionalProperties": {}
      }
    }
  },
  "required": ["records"],
  "additionalProperties": {}
}
